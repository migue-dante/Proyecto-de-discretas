{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar proyecto",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17", "-Wall", "-Wextra",
        "-Isrc",
        "src/main.cpp",
        "src/conjuntos/conjuntos.cpp",
        "src/relaciones/relaciones.cpp",
        "src/proposiciones/proposiciones.cpp",
        "src/predicados/predicados.cpp",
        "src/funciones/funciones.cpp",
        "-o", "${workspaceFolder}/discretas"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}
